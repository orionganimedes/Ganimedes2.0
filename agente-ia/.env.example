# Ganimedes Agent — variables de entorno
# Copia a `.env` y ajusta según tu entorno.

# PocketBase (base de datos multi-tenant)
POCKETBASE_URL=http://localhost:8090

# Ollama (motor LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Puerto del agente
AGENT_PORT=8000

# CORS (orígenes separados por coma; * para desarrollo)
CORS_ORIGINS=*

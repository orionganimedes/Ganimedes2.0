{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "POS: matar instancia previa",
            "type": "shell",
            "command": "pkill -x ganimedes-pos 2>/dev/null; exit 0",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": true
            },
            "problemMatcher": [],
            "detail": "Cierra la ventana del POS que estuviera abierta antes de relanzar."
        },
        {
            "label": "POS: compilar y lanzar",
            "type": "shell",
            "command": "pkill -x ganimedes-pos 2>/dev/null; cargo run --release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": ["$rustc"],
            "detail": "Mata la instancia anterior y vuelve a compilar+lanzar. Atajo: Ctrl+Shift+B"
        },
        {
            "label": "POS: compilar y lanzar (dev, rápido)",
            "type": "shell",
            "command": "pkill -x ganimedes-pos 2>/dev/null; cargo run",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": ["$rustc"],
            "detail": "Perfil dev: recompila en 3-4 s. Es el que quieres para iterar."
        },
        {
            "label": "POS: vigilar y relanzar al guardar",
            "type": "shell",
            "command": "pkill -x ganimedes-pos 2>/dev/null; cargo watch -q -w src -w assets -x run",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "detail": "Requiere cargo-watch (ya instalado). Recompila (~3 s) y relanza cada vez que guardas. Sin -c: esa bandera falla sin terminal interactiva."
        },
        {
            "label": "POS: solo comprobar (cargo check)",
            "type": "shell",
            "command": "cargo check --workspace",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": ["$rustc"],
            "detail": "No genera binario: es lo más rápido para ver si hay errores de tipos."
        },
        {
            "label": "POS: tests",
            "type": "shell",
            "command": "cargo test --workspace",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "POS: vista previa del login",
            "type": "shell",
            "command": "cargo run -p ganimedes-login-preview",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [],
            "detail": "Solo la pantalla de acceso, para iterar el login sin pasar por el POS."
        }
    ]
}

# PocketBase Configuration
# URL del servidor de PocketBase (por defecto: http://localhost:8090)
POCKETBASE_URL=http://localhost:8090

# Credenciales de administrador (solo para desarrollo)
POCKETBASE_EMAIL=admin@panelpc.local
POCKETBASE_PASSWORD=admin123456

# Configuración de la sucursal por defecto
DEFAULT_BRANCH_CODE=MAIN01

# Modo de desarrollo (true/false)
DEBUG_MODE=true
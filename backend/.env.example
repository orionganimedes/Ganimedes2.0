# =============================================================================
# Ganimedes Backend — Variables de entorno
# Copia este archivo a `.env` y ajusta los valores antes de desplegar.
#   cp .env.example .env
# =============================================================================

# Superusuario (se crea/actualiza automáticamente al arrancar el contenedor)
PB_ADMIN_EMAIL=admin@ganimedes.com
PB_ADMIN_PASSWORD=CambiaEstaClaveSegura2026!

# Zona horaria del contenedor
TZ=America/Mexico_City

# (Producción) Clave de 32 caracteres para cifrar configuraciones sensibles.
# Genera una con:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# PB_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
